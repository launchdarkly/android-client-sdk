name: contract-tests

on:
  workflow_dispatch:
  push:
    branches:
      - 'main'
    paths-ignore:
      - '**.md'
  pull_request:
    branches:
      - 'main'
    paths-ignore:
      - '**.md'

jobs:
  android-cm-gate:
    runs-on: ubuntu-22.04
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - uses: android-actions/setup-android@be39fa834029ff78f1a44aa3bb0819b8fc2bd8fd # v4.0.4 - the repo composite action's own pin

      - name: run - register family 'android' ConnectivityManagerTest replay faces (a243c235 FDv2-OFFLINE double-window)
        run: ./gradlew :launchdarkly-android-client-sdk:testDebugUnitTest --tests 'com.launchdarkly.sdk.android.ConnectivityManagerTest'

      - name: lint
        run: ./gradlew :launchdarkly-android-client-sdk:lintDebug
